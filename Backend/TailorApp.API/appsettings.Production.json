{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "ConnectionStrings": {
    "DefaultConnection": "Server=tcp:YOUR-SERVER.database.windows.net,1433;Database=TailorAppDB;User Id=YOUR-DB-USER;Password=YOUR-DB-PASSWORD;Encrypt=True;TrustServerCertificate=False;"
  },

  "App": {
    "FrontendBaseUrl": "https://YOUR-APP-NAME.azurewebsites.net"
  },

  "Cors": {
    "AllowedOrigins": []
  },

  "Jwt": {
    "Key": "REPLACE-WITH-A-LONG-RANDOM-SECRET-AT-LEAST-32-CHARS",
    "Issuer": "TailorApp.API",
    "Audience": "TailorApp.Client"
  },

  "Google": {
    "ClientId": "YOUR-GOOGLE-CLIENT-ID.apps.googleusercontent.com",
    "ClientSecret": "YOUR-GOOGLE-CLIENT-SECRET"
  }
}
